# Copie para .env e preencha com o config do Firebase Console (App Web).
# Auth: Anonymous ON + Email/senha ON · Firestore rules em players/{uid}
# Login no lobby é opcional (convidado joga sem conta).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
